# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Loki HTTP push backend for obs-eio"
description: """
Converts obs-eio span events into structured logfmt log lines and pushes them to
Loki's push API when each span closes. Not a general-purpose Loki client: it is the
Loki backend for obs-eio's Obs_eio.backend interface."""
maintainer: ["lbendtlynielsen@gmail.com"]
authors: ["lbendtly"]
license: "MIT"
homepage: "https://github.com/loganbnielsen/obs-loki-eio"
bug-reports: "https://github.com/loganbnielsen/obs-loki-eio/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.4.0"}
  "obs-eio" {>= "0.1.0"}
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3" & with-test}
  "cohttp-eio" {>= "6.2.0"}
  "uri" {>= "4.4.0"}
  "http" {>= "6.0.0"}
  "yojson" {>= "3.0.0"}
  "tls-eio" {>= "2.1.0"}
  "x509" {>= "1.0.0"}
  "domain-name" {>= "0.5.0"}
  "ptime" {>= "1.2.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/loganbnielsen/obs-loki-eio.git"
